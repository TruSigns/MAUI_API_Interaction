<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RSVP_App.EventDetailsPage"
    Title="Event Details">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Event Details"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblEventName"
                FontSize="24"
                FontAttributes="Bold" />

            <Label x:Name="lblDate" />

            <Label x:Name="lblTime" />

            <Label x:Name="lblLocation" />

            <Label x:Name="lblHost" />

            <Button
                Text="RSVP"
                Clicked="OnRSVPClicked" />

            <Button
                Text="Go Back"
                Clicked="OnGoBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>