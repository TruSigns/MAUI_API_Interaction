<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RSVP_App.EventsPage"
    Title="Events">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                x:Name="lblPageTitle"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Button
                Text="Birthday Dinner"
                Clicked="OnBirthdayClicked" />

            <Button
                Text="Software Meetup"
                Clicked="OnMeetupClicked" />

            <Button
                Text="Family Cookout"
                Clicked="OnCookoutClicked" />

            <Button
                Text="Go Back"
                Clicked="OnGoBackClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>