<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RSVP_App.RSVPPage"
    Title="RSVP">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="RSVP"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblEventName"
                FontSize="20"
                HorizontalOptions="Center" />

            <Label Text="Name" />

            <Entry
                x:Name="txtName"
                Placeholder="Enter your name" />

            <Label Text="Email" />

            <Entry
                x:Name="txtEmail"
                Placeholder="Enter your email"
                Keyboard="Email" />

            <Label Text="Number of Guests" />

            <Entry
                x:Name="txtGuests"
                Placeholder="Enter number of guests"
                Keyboard="Numeric" />

            <Label Text="Response" />

            <Picker
                x:Name="pickerResponse"
                Title="Select response">

                <Picker.Items>
                    <x:String>Attending</x:String>
                    <x:String>Maybe</x:String>
                    <x:String>Not Attending</x:String>
                </Picker.Items>

            </Picker>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Submit RSVP"
                    Clicked="OnSubmitClicked" />

                <Button
                    Grid.Column="1"
                    Text="Cancel"
                    Clicked="OnCancelClicked" />

            </Grid>

            <Label
                x:Name="lblMessage"
                FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>