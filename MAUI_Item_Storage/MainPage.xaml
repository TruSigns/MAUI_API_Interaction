<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MAUI_Item_Storage.Models"
    x:Class="MAUI_Item_Storage.MainPage">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Maurice Item Storage"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="Please provide the following information:"
            FontSize="18"
            HorizontalOptions="Center" />

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,*"
            RowSpacing="10"
            ColumnSpacing="15">

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="Item ID"
                VerticalTextAlignment="Center" />

            <Entry
                Grid.Row="0"
                Grid.Column="1"
                x:Name="txtItemID"
                Placeholder="Enter item ID"
                Keyboard="Numeric" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Text="Item Name"
                VerticalTextAlignment="Center" />

            <Entry
                Grid.Row="1"
                Grid.Column="1"
                x:Name="txtItemName"
                Placeholder="Enter item name" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Text="Item Description"
                VerticalTextAlignment="Center" />

            <Entry
                Grid.Row="2"
                Grid.Column="1"
                x:Name="txtItemDescription"
                Placeholder="Enter item description" />

        </Grid>

        <Button
            Grid.Row="3"
            Text="Save"
            HorizontalOptions="Center"
            Clicked="OnSaveClicked" />

        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Items}"
            VerticalOptions="Fill">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Item">

                    <Grid
                        ColumnDefinitions="Auto,*,*"
                        Padding="10">

                        <Label
                            Grid.Column="0"
                            Text="{Binding ItemID}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding ItemName}" />

                        <Label
                            Grid.Column="2"
                            Text="{Binding ItemDescription}" />

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>