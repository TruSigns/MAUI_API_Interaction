<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MauiBasicAuth.Models"
    x:Class="MauiBasicAuth.DataEntryPage"
    Title="Items">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Maurice Ruffin"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="Please provide the following information:"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            Grid.Row="2">

            <Label Text="Item ID" />

            <Entry
                Text="{Binding ItemID}"
                Keyboard="Numeric" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="3">

            <Label Text="Item Name" />

            <Entry
                Text="{Binding ItemName}" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="4">

            <Label Text="Item Description" />

            <Entry
                Text="{Binding ItemDescription}" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="5"
            Spacing="10">

            <Button
                Text="Save"
                Command="{Binding SaveCommand}" />

            <Label
                Text="{Binding Message}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="6"
            ItemsSource="{Binding Items}">

            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="models:Item">

                    <Grid
                        Padding="10"
                        ColumnDefinitions="Auto,*,*"
                        ColumnSpacing="15">

                        <Label
                            Grid.Column="0"
                            Text="{Binding ItemID}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding ItemName}" />

                        <Label
                            Grid.Column="2"
                            Text="{Binding ItemDescription}" />

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>